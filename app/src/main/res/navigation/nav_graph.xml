<?xml version="1.0" encoding="utf-8"?>
<!-- Navigation Component graph: every screen of the app and how they connect.
     The five bottom-bar sections use the same ids as res/menu/bottom_nav_menu.xml. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/prioritiesFragment">

    <fragment
        android:id="@+id/selfAssessmentFragment"
        android:name="com.equilibra.app.ui.selfassessment.SelfAssessmentFragment"
        android:label="@string/nav_self_assessment">
        <action
            android:id="@+id/action_selfAssessment_to_wheelEdit"
            app:destination="@id/wheelEditFragment" />
    </fragment>

    <!-- Rate the balance wheel / edit a saved rating. assessmentId = -1 means a new rating. -->
    <fragment
        android:id="@+id/wheelEditFragment"
        android:name="com.equilibra.app.ui.selfassessment.WheelEditFragment"
        android:label="@string/wheel_edit_title">
        <argument
            android:name="assessmentId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/habitsFragment"
        android:name="com.equilibra.app.ui.habits.HabitsFragment"
        android:label="@string/nav_habits">
        <action
            android:id="@+id/action_habits_to_activityEdit"
            app:destination="@id/activityEditFragment" />
    </fragment>

    <!-- Add / edit an activity. activityId = -1 means a new activity.
         date = the day shown in the list (days since 1970-01-01), used for a new activity. -->
    <fragment
        android:id="@+id/activityEditFragment"
        android:name="com.equilibra.app.ui.habits.ActivityEditFragment"
        android:label="@string/activity_edit_title">
        <argument
            android:name="activityId"
            android:defaultValue="-1L"
            app:argType="long" />
        <argument
            android:name="date"
            android:defaultValue="0L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/prioritiesFragment"
        android:name="com.equilibra.app.ui.priorities.PrioritiesFragment"
        android:label="@string/nav_priorities">
        <action
            android:id="@+id/action_priorities_to_taskEdit"
            app:destination="@id/taskEditFragment" />
    </fragment>

    <!-- Add / edit a task. taskId = -1 means a new task. -->
    <fragment
        android:id="@+id/taskEditFragment"
        android:name="com.equilibra.app.ui.task.TaskEditFragment"
        android:label="@string/task_edit_title">
        <argument
            android:name="taskId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/journalFragment"
        android:name="com.equilibra.app.ui.journal.JournalFragment"
        android:label="@string/nav_journal">
        <action
            android:id="@+id/action_journal_to_journalEdit"
            app:destination="@id/journalEditFragment" />
    </fragment>

    <!-- Add / edit a journal entry. entryId = -1 means a new entry. -->
    <fragment
        android:id="@+id/journalEditFragment"
        android:name="com.equilibra.app.ui.journal.JournalEditFragment"
        android:label="@string/journal_edit_title">
        <argument
            android:name="entryId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/mySystemFragment"
        android:name="com.equilibra.app.ui.mysystem.MySystemFragment"
        android:label="@string/nav_my_system" />

    <!-- Not in the bottom bar: opened from the toolbar, shows a back arrow. -->
    <fragment
        android:id="@+id/steamModeFragment"
        android:name="com.equilibra.app.ui.steam.SteamModeFragment"
        android:label="@string/steam_mode" />

</navigation>
