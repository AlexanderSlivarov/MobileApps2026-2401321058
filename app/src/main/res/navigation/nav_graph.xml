<?xml version="1.0" encoding="utf-8"?>
<!-- Navigation Component graph: every screen of the app and how they connect.
     The five bottom-bar sections use the same ids as res/menu/bottom_nav_menu.xml.
     The app opens on step 1 (Me), because the STEAM dashboard presents the steps in order. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/selfAssessmentFragment">

    <fragment
        android:id="@+id/selfAssessmentFragment"
        android:name="com.equilibra.app.ui.selfassessment.SelfAssessmentFragment"
        android:label="@string/nav_self_assessment">
        <action
            android:id="@+id/action_selfAssessment_to_wheelEdit"
            app:destination="@id/wheelEditFragment" />
        <action
            android:id="@+id/action_selfAssessment_to_selfEdit"
            app:destination="@id/selfEditFragment" />
    </fragment>

    <!-- Answer the questions of one half and write my own words. part 0 = "Who am I?", 1 = "How do I manage my time?". -->
    <fragment
        android:id="@+id/selfEditFragment"
        android:name="com.equilibra.app.ui.selfassessment.SelfEditFragment"
        android:label="@string/section_self_assessment">
        <argument
            android:name="part"
            android:defaultValue="0"
            app:argType="integer" />
    </fragment>

    <!-- Rate the balance wheel / edit a saved rating. assessmentId = -1 means a new rating. -->
    <fragment
        android:id="@+id/wheelEditFragment"
        android:name="com.equilibra.app.ui.selfassessment.WheelEditFragment"
        android:label="@string/wheel_edit_title">
        <argument
            android:name="assessmentId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/habitsFragment"
        android:name="com.equilibra.app.ui.habits.HabitsFragment"
        android:label="@string/nav_habits">
        <action
            android:id="@+id/action_habits_to_findingEdit"
            app:destination="@id/findingEditFragment" />
    </fragment>

    <!-- Add / edit a finding (with the 5 Whys for a problem). findingId = -1 means a new finding. -->
    <fragment
        android:id="@+id/findingEditFragment"
        android:name="com.equilibra.app.ui.habits.FindingEditFragment"
        android:label="@string/finding_edit_title">
        <argument
            android:name="findingId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/prioritiesFragment"
        android:name="com.equilibra.app.ui.priorities.PrioritiesFragment"
        android:label="@string/nav_priorities" />

    <fragment
        android:id="@+id/decisionsFragment"
        android:name="com.equilibra.app.ui.decisions.DecisionsFragment"
        android:label="@string/nav_decisions">
        <action
            android:id="@+id/action_decisions_to_decisionEdit"
            app:destination="@id/decisionEditFragment" />
    </fragment>

    <!-- Add / edit a decision. decisionId = -1 means a new decision. -->
    <fragment
        android:id="@+id/decisionEditFragment"
        android:name="com.equilibra.app.ui.decisions.DecisionEditFragment"
        android:label="@string/decision_edit_title">
        <argument
            android:name="decisionId"
            android:defaultValue="-1L"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/mySystemFragment"
        android:name="com.equilibra.app.ui.mysystem.MySystemFragment"
        android:label="@string/nav_my_system" />

</navigation>
