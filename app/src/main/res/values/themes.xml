<resources>
    <!-- "Day & Night" theme: light mode is a warm day, dark mode a calm night, the balance
         between activity and rest. DayNight switches automatically with the phone setting,
         and the colors come from values/colors.xml or values-night/colors.xml. -->
    <style name="Base.Theme.Equilibra" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>

        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>

        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>

        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>

        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>

        <!-- Typography: Nunito everywhere (see values/type.xml) -->
        <item name="fontFamily">@font/nunito</item>
        <item name="android:fontFamily">@font/nunito</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Equilibra.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Equilibra.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Equilibra.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Equilibra.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Equilibra.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Equilibra.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Equilibra.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Equilibra.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Equilibra.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Equilibra.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Equilibra.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Equilibra.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Equilibra.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Equilibra.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Equilibra.LabelSmall</item>

        <!-- Shapes: rounder corners (see values/shape.xml) -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Equilibra.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Equilibra.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Equilibra.Large</item>
    </style>

    <style name="Theme.Equilibra" parent="Base.Theme.Equilibra" />
</resources>
