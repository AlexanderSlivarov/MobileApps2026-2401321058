<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 type scale with Nunito instead of Roboto.
     Headlines are extra bold, titles bold, labels semibold, body regular. -->
<resources>
    <style name="TextAppearance.Equilibra.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="fontFamily">@font/nunito_extrabold</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
    </style>
    <style name="TextAppearance.Equilibra.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="fontFamily">@font/nunito_extrabold</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
    </style>
    <style name="TextAppearance.Equilibra.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/nunito_extrabold</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
    </style>

    <style name="TextAppearance.Equilibra.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/nunito_extrabold</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
    </style>
    <style name="TextAppearance.Equilibra.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/nunito_extrabold</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
    </style>
    <style name="TextAppearance.Equilibra.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/nunito_extrabold</item>
        <item name="android:fontFamily">@font/nunito_extrabold</item>
    </style>

    <style name="TextAppearance.Equilibra.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/nunito_bold</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
    </style>
    <style name="TextAppearance.Equilibra.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/nunito_bold</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
    </style>
    <style name="TextAppearance.Equilibra.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="fontFamily">@font/nunito_bold</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
    </style>

    <style name="TextAppearance.Equilibra.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/nunito</item>
        <item name="android:fontFamily">@font/nunito</item>
    </style>
    <style name="TextAppearance.Equilibra.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/nunito</item>
        <item name="android:fontFamily">@font/nunito</item>
    </style>
    <style name="TextAppearance.Equilibra.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/nunito</item>
        <item name="android:fontFamily">@font/nunito</item>
    </style>

    <style name="TextAppearance.Equilibra.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
    </style>
    <style name="TextAppearance.Equilibra.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
    </style>
    <style name="TextAppearance.Equilibra.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/nunito_semibold</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
    </style>
</resources>
