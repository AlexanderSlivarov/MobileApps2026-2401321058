<?xml version="1.0" encoding="utf-8"?>
<!-- One priority: its number in my order in a circle of its group's color, the title,
     the group in the same color, and the up/down buttons. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Material3.CardView.Elevated"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingVertical="10dp"
        android:paddingStart="16dp"
        android:paddingEnd="4dp">

        <TextView
            android:id="@+id/text_number"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_number_circle"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            tools:backgroundTint="@color/group_i"
            tools:text="1" />

        <!-- Title and its group, e.g. "Do now · important and urgent" -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="Prepare for the exam" />

            <TextView
                android:id="@+id/text_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                tools:text="Do now · important and urgent"
                tools:textColor="@color/group_i" />
        </LinearLayout>

        <Button
            android:id="@+id/button_up"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/move_up"
            app:icon="@drawable/ic_arrow_upward" />

        <Button
            android:id="@+id/button_down"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/move_down"
            app:icon="@drawable/ic_arrow_downward" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
