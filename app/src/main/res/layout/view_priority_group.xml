<?xml version="1.0" encoding="utf-8"?>
<!-- One Eisenhower group on Priorities: a dot and the group name in its color, then its
     priorities. A priority can be moved only inside its group, so the groups keep their order. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/view_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_number_circle"
            tools:backgroundTint="@color/group_i" />

        <TextView
            android:id="@+id/text_group_title"
            style="@style/Widget.Equilibra.Eyebrow"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            tools:text="Do now · important and urgent"
            tools:textColor="@color/group_i" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
</LinearLayout>
