<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.mysystem.MySystemFragment">

    <!-- Everything on the page; this is what the PDF draws -->
    <LinearLayout
        android:id="@+id/layout_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Self-assessment: my answers as rows, my own words, and the wheel -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Widget.Equilibra.Eyebrow"
                    android:text="@string/section_self_assessment" />

                <LinearLayout
                    android:id="@+id/layout_self_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/self_who_am_i"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorPrimary" />

                    <!-- One row per answer (view_answer_tile), then my own words; added in code -->
                    <LinearLayout
                        android:id="@+id/layout_who_rows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/self_manage_time"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorPrimary" />

                    <LinearLayout
                        android:id="@+id/layout_time_rows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <com.equilibra.app.ui.common.BalanceWheelView
                    android:id="@+id/wheel_view"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="12dp"
                    android:contentDescription="@string/wheel_title" />

                <TextView
                    android:id="@+id/text_wheel_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_horizontal"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:text="@string/wheel_empty" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Habit analysis: three number tiles -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Widget.Equilibra.Eyebrow"
                    android:text="@string/section_habits" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/tile_problems"
                        layout="@layout/view_stat_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="0dp" />

                    <include
                        android:id="@+id/tile_habits"
                        layout="@layout/view_stat_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="0dp" />

                    <include
                        android:id="@+id/tile_needs"
                        layout="@layout/view_stat_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_traced"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="1 problem traced with 5 Whys" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Prioritization: the priorities in order, each with its group -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Widget.Equilibra.Eyebrow"
                    android:text="@string/section_priorities" />

                <TextView
                    android:id="@+id/text_priorities_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/priorities_empty"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <!-- Rows added in code (item_balance_priority) -->
                <LinearLayout
                    android:id="@+id/layout_priorities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/text_not_started"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="1 postponed thing" />

                <!-- The postponed things, one per line; hidden while there are none -->
                <TextView
                    android:id="@+id/text_postponed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="4dp"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    tools:text="• Snowflake certificate" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- My week: the priorities on the days I planned them (shown when any day is planned) -->
        <include
            android:id="@+id/week"
            layout="@layout/view_week"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <!-- 4. Balance tracking: a progress bar and three number tiles -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Widget.Equilibra.Eyebrow"
                    android:text="@string/section_decisions" />

                <TextView
                    android:id="@+id/text_decisions_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    tools:text="2 of 3 decisions worked" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progress_decisions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    app:indicatorColor="@color/result_worked"
                    app:indicatorTrackGapSize="0dp"
                    app:trackColor="?attr/colorSurfaceContainerHighest"
                    app:trackCornerRadius="4dp"
                    app:trackStopIndicatorSize="0dp"
                    app:trackThickness="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/tile_worked"
                        layout="@layout/view_stat_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="0dp" />

                    <include
                        android:id="@+id/tile_did_not_work"
                        layout="@layout/view_stat_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="0dp" />

                    <include
                        android:id="@+id/tile_pending"
                        layout="@layout/view_stat_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- Each decision with its 7 days; added in code (item_balance_decision) -->
                <LinearLayout
                    android:id="@+id/layout_decisions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Statistics: numbers and facts worked out from my data -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_statistics"
            style="@style/Widget.Material3.CardView.Elevated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    style="@style/Widget.Equilibra.Eyebrow"
                    android:text="@string/stats_title" />

                <!-- Rows of two tiles (item_stat_tile), added in code -->
                <LinearLayout
                    android:id="@+id/layout_statistics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Saves a report of all my data as a PDF where I choose -->
        <Button
            android:id="@+id/button_save_pdf"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/export_pdf"
            app:icon="@drawable/ic_pdf" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
