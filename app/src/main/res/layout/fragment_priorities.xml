<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.priorities.PrioritiesFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="88dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- My priorities in order -->
            <TextView
                style="@style/Widget.Equilibra.Eyebrow"
                android:layout_marginTop="4dp"
                android:text="@string/priorities_list_title" />

            <include
                android:id="@+id/empty"
                layout="@layout/view_empty_state" />

            <!-- One section per group, always in this order; empty groups are hidden -->
            <include
                android:id="@+id/group_i"
                layout="@layout/view_priority_group" />

            <include
                android:id="@+id/group_ii"
                layout="@layout/view_priority_group" />

            <include
                android:id="@+id/group_iii"
                layout="@layout/view_priority_group" />

            <include
                android:id="@+id/group_iv"
                layout="@layout/view_priority_group" />

            <!-- "I consciously didn't start" -->
            <!-- Shown only when something is postponed -->
            <TextView
                android:id="@+id/text_not_started_title"
                style="@style/Widget.Equilibra.Eyebrow"
                android:layout_marginTop="28dp"
                android:text="@string/not_started_title" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_not_started"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- Extra feature: Share Intent -->
            <Button
                android:id="@+id/button_share"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/share_priorities"
                app:icon="@drawable/ic_share" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_add_task"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/action_add"
        app:icon="@drawable/ic_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
