<?xml version="1.0" encoding="utf-8"?>
<!-- App icon "E in balance": the letter E of Equilibra resting on a pivot point.
     Drawn inside the central 66dp safe zone, so no launcher mask (circle, squircle...) cuts it.
     The bars are lines with round ends; the middle one is gold, like the needle of a scale. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Vertical bar of the E -->
    <path
        android:pathData="M40,34 L40,62"
        android:strokeWidth="8"
        android:strokeColor="#C6C2FF"
        android:strokeLineCap="round" />
    <!-- Top and bottom bars -->
    <path
        android:pathData="M40,34 L64,34 M40,62 L64,62"
        android:strokeWidth="8"
        android:strokeColor="#C6C2FF"
        android:strokeLineCap="round" />
    <!-- Middle bar -->
    <path
        android:pathData="M48,48 L58,48"
        android:strokeWidth="8"
        android:strokeColor="#F2C14E"
        android:strokeLineCap="round" />
    <!-- Pivot point under the centre -->
    <path
        android:fillColor="#7F77DD"
        android:pathData="M52,69 L61,81 L43,81 Z" />
</vector>
